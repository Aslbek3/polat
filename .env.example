# Boshlang'ich admin hisobi (birinchi marta `npm run migrate` ishga tushganda yaratiladi,
# keyingi safar mavjud bo'lsa qayta yozilmaydi). Kirgandan keyin admin panelidan boshqa
# admin/afitsiant hisoblarini qo'shishingiz mumkin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Server porti (3210 - claude-code-web, 3212 - savdo-hisob band, shu sabab 3213)
PORT=3213

# Server qaysi interfeysda tinglaydi. VPS'da nginx/asosiy proksi orqasida: 127.0.0.1
HOST=127.0.0.1

# Cookie imzolash uchun tasodifiy maxfiy kalit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bo'sh qoldirsangiz avtomatik yaratiladi, lekin server qayta ishga tushganda
# eski sessiyalar bekor bo'ladi — doimiy qiymat qo'yish tavsiya etiladi.
SESSION_SECRET=

# O'z alohida nginx server bloki orqasida ishlaydi (https://polatuz.duckdns.org,
# /etc/nginx/sites-available/polatuz) — shu sabab 1 (nginx X-Forwarded-Proto orqali
# HTTPS ekanini bildiradi, server buni to'g'ri o'qishi uchun trust proxy yoqilishi SHART,
# aks holda sessiya cookie'sida Secure belgisi to'g'ri qo'yilmaydi).
TRUST_PROXY=1

# Oshxona printer agenti (print-agent.js, WebSocket wss://<domen>/print-agent)
# shu token bilan ulanadi: Authorization: Bearer <PRINT_TOKEN>.
# Bo'sh qoldirilsa server ISHLAYDI, lekin oshxona printeri o'chirilgan bo'ladi
# (cheklar navbatga yoziladi, chop etilmaydi). Yaratish:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PRINT_TOKEN=

# Navbatdagi chop etilmagan chekning amal qilish muddati (daqiqa). Agent shundan
# uzoqroq oflayn bo'lsa, eski cheklar qayta ulanganda chiqmaydi. Standart: 120.
PRINT_JOB_MAX_AGE_MIN=120

# Baza zaxirasi: nechta nusxa saqlanadi va necha soatda bir olinadi.
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# Mijozlar saytga kirishi (2026-11-01, "Mijoz hisobi"): @BotFather'dan olingan
# YANGI bot tokeni. Bu bot boshqa joyda (webhook yoki boshqa server) ishlatilmasin —
# server o'zi getUpdates (long polling) qiladi. Bo'sh bo'lsa sayt ishlaydi,
# faqat "Kirish" tugmasi "hozircha ishlamayapti" deydi.
TELEGRAM_BOT_TOKEN=
# Ixtiyoriy — odatda server getMe orqali o'zi aniqlaydi.
TELEGRAM_BOT_USERNAME=

# SMS orqali kod (ixtiyoriy, Telegram'i yo'q mijozlar uchun zaxira). Eskiz.uz
# kabinetidagi login. Bo'sh bo'lsa saytda "SMS orqali" tugmasi chiqmaydi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Tasdiqlangan alfa-nom (masalan ZiyoFamily). Bo'sh = Eskiz umumiy raqami 4546.
ESKIZ_FROM=
# Operatorlarda tasdiqlangan shablon bilan HARFMA-HARF bir xil bo'lsin, {code} = kod.
SMS_CODE_TEMPLATE=Ziyo Family: kirish kodingiz {code}. Kodni hech kimga bermang.
# Pul himoyasi: bitta raqamga va butun saytga sutkada nechta SMS.
SMS_PER_PHONE_DAILY=5
SMS_DAILY_LIMIT=300
