# Boshlang'ich admin hisobi (birinchi marta `npm run migrate` ishga tushganda yaratiladi,
# keyingi safar mavjud bo'lsa qayta yozilmaydi). Kirgandan keyin admin panelidan boshqa
# admin/afitsiant hisoblarini qo'shishingiz mumkin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Server porti (3210 - claude-code-web, 3212 - savdo-hisob band, shu sabab 3213)
PORT=3213

# Server qaysi interfeysda tinglaydi. VPS'da nginx/asosiy proksi orqasida: 127.0.0.1
HOST=127.0.0.1

# Cookie imzolash uchun tasodifiy maxfiy kalit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bo'sh qoldirsangiz avtomatik yaratiladi, lekin server qayta ishga tushganda
# eski sessiyalar bekor bo'ladi — doimiy qiymat qo'yish tavsiya etiladi.
SESSION_SECRET=

# O'z alohida nginx server bloki orqasida ishlaydi (https://polatuz.duckdns.org,
# /etc/nginx/sites-available/polatuz) — shu sabab 1 (nginx X-Forwarded-Proto orqali
# HTTPS ekanini bildiradi, server buni to'g'ri o'qishi uchun trust proxy yoqilishi SHART,
# aks holda sessiya cookie'sida Secure belgisi to'g'ri qo'yilmaydi).
TRUST_PROXY=1
