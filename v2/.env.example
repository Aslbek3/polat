# --- Server ---
NODE_ENV=development
PORT=3214
HOST=127.0.0.1
# nginx ortida: 1 (Secure cookie va to'g'ri req.ip uchun SHART)
TRUST_PROXY=0
LOG_LEVEL=info

# --- PostgreSQL ---
DATABASE_URL=postgres://polat:polat@127.0.0.1:5432/polat
DATABASE_POOL_MAX=10
# Testlar alohida bazada ishlaydi (har test ishga tushganda tozalanadi!)
TEST_DATABASE_URL=postgres://polat:polat@127.0.0.1:5432/polat_test

# --- Xavfsizlik ---
# Kamida 32 belgi. Production'da bo'sh bo'lsa server ISHGA TUSHMAYDI.
SESSION_SECRET=

# --- Oshxona printeri (ixtiyoriy) ---
PRINT_TOKEN=
PRINT_JOB_MAX_AGE_MIN=120

# --- Mijoz kirishi (ixtiyoriy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=
SMS_CODE_TEMPLATE=
SMS_PER_PHONE_DAILY=5
SMS_DAILY_LIMIT=300
